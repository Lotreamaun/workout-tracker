# Backend (apps/api)
PORT=3000
HOST=0.0.0.0
# Путь к SQLite-файлу относительно корня репозитория (или абсолютный)
DB_PATH=data/workout-tracker.db
# Каталог медиа упражнений относительно корня репозитория (или абсолютный). Нужен ffmpeg в PATH.
MEDIA_DIR=data/media
# Путь к бинарнику ffmpeg, если его нет в PATH
# FFMPEG_PATH=ffmpeg
# Общий ключ доступа к /api (Authorization: Bearer ...). Без него API открыт. Сгенерировать: openssl rand -hex 32
# API_TOKEN=
# Список разрешённых origin через запятую. Для iPhone в LAN добавьте адрес компьютера.
CORS_ORIGINS=http://localhost:5173,http://192.168.1.10:5173
# Только dev: разрешить любые origin из частных сетей (localhost, 10.x, 172.16-31.x, 192.168.x)
CORS_ALLOW_PRIVATE_NETWORK=true

# Frontend (apps/web)
# Если не задан, используется http://<location.hostname>:3000
# VITE_API_URL=http://localhost:3000
